# =============================================================================
# MCP Architecture Review — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Usage: When LLM_BASE_URL + LLM_MODEL are set, the interactive provider
#        menu is bypassed entirely. This is the recommended approach for
#        automated runs and CI/CD.
# =============================================================================

# --- Ollama (auto-detected, no env vars needed) ---
# Just run `ollama serve` and select [O] in the provider menu.

# --- Groq (free tier: https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (free tier: https://openrouter.ai) ---
# OPENROUTER_API_KEY=sk-or-...

# --- GitHub Models (free: https://github.com/marketplace/models) ---
# GITHUB_TOKEN=ghp_...
# GH_MODEL=gpt-4o-mini

# --- Cloudflare Workers AI (free tier) ---
# CF_ACCOUNT_ID=
# CF_API_KEY=
# CF_MODEL=@cf/meta/llama-3.2-3b-instruct

# --- Azure OpenAI (needs Azure subscription) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://xxxx.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.3-codex

# --- Azure Anthropic (needs Azure subscription) ---
# AZURE_ANTHROPIC_API_KEY=
# AZURE_ANTHROPIC_ENDPOINT=https://xxxx.services.ai.azure.com
# AZURE_ANTHROPIC_DEPLOYMENT_NAME=claude-sonnet-4-5

# --- Generic OpenAI-compatible endpoint ---
# Set these to bypass the interactive provider menu entirely:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3-8b
# LLM_INJECT_NO_THINK=false
