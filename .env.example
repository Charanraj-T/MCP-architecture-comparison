# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_ENDPOINT=https://gitnexus-test.openai.azure.com/openai/v1/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.3-codex  # also: Ministral-3B

# --- Azure Anthropic ---
# AZURE_ANTHROPIC_API_KEY=your-azure-anthropic-api-key
# AZURE_ANTHROPIC_ENDPOINT=https://kavin-mnh5g313-eastus2.services.ai.azure.com/anthropic/
# AZURE_ANTHROPIC_DEPLOYMENT_NAME=claude-sonnet-4-5

# --- Ollama (auto-detected, no env vars needed) ---

# --- Groq (free tier: https://console.groq.com) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile   # default; also: mixtral-8x7b-32768, gemma2-9b-it, llama-3.1-8b-instant

# --- OpenRouter (free tier: https://openrouter.ai) ---
# OPENROUTER_API_KEY=sk-or-...

# --- GitHub Models (free: https://github.com/marketplace/models) ---
# GITHUB_TOKEN=ghp_...
# GH_MODEL=gpt-4o-mini   # default

# --- Cloudflare Workers AI (free tier) ---
# CF_ACCOUNT_ID=...
# CF_API_KEY=...
# CF_MODEL=@cf/meta/llama-3.2-3b-instruct

# --- Generic OpenAI-compatible endpoint ---
# Set these to bypass the interactive provider menu entirely:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2:3b
# LLM_INJECT_NO_THINK=false
